# ======================
# DeepSeek API
# pi-ai 内置 DeepSeek provider，直接读 DEEPSEEK_API_KEY
# ======================
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# 兼容别名（main.ts 会自动把这些 fallback 到 DEEPSEEK_API_KEY）
OPENAI_API_KEY=sk-your-deepseek-api-key-here
LLM_API_KEY=sk-your-deepseek-api-key-here

# ======================
# Embedding 服务（推荐用国内 OpenAI 兼容服务，比如阿里云灵积 / 智谱 / SiliconFlow）
# 不配置则尝试 OPENAI_API_KEY 直连 OpenAI；都连不上则降级到 TF-IDF 离线模式
# ======================
# 例 1：硅基流动 SiliconFlow（免费额度，速度快）
# EMBED_BASE_URL=https://api.siliconflow.cn/v1
# EMBED_API_KEY=sk-your-siliconflow-key
# EMBED_MODEL=BAAI/bge-large-zh-v1.5

# 例 2：阿里云灵积（DashScope）
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBED_API_KEY=sk-your-dashscope-key
# EMBED_MODEL=text-embedding-v3

# 例 3：智谱 BigModel
# EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBED_API_KEY=your-zhipu-key
# EMBED_MODEL=embedding-3

# ======================
# 模型选择
# ======================
# 可选: deepseek-v4-pro（推理强）/ deepseek-v4-flash（更快）
DEFAULT_MODEL=deepseek-v4-pro
REVIEW_MODEL=deepseek-v4-pro

# ======================
# Agent 配置
# ======================
MAX_REVIEW_ITERATIONS=5
MIN_REVIEW_SCORE=8.0
